# Supabase project credentials — copy to .env.local and fill in.
# Without these the app runs fully offline against the local store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Simple access gate for the grower entry form (no real auth in MVP)
VITE_ACCESS_CODE=spud26

# Staff sign-in gate. "false" leaves every staff page open to anyone with the
# address — which is how it ships, until a magic link has been proven to work.
# See docs/staff-sign-in.md.
VITE_REQUIRE_STAFF_SIGNIN=false
